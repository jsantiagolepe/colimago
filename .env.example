# Variables de entorno de colimago. En local van en un archivo .env (no se
# sube a git). En Vercel se capturan en Settings -> Environment Variables
# del proyecto (no hace falta PORT ni NODE_ENV: Vercel los pone solo).
PORT=3001

# Interruptor del panel de administración (/login, /dashboard.html, /auth/*,
# /api/*). Apagado mientras no valga exactamente 1: sus rutas responden 404.
# Ver "Panel de administración: desactivado" en el README.
PANEL_ACTIVO=0

# Analítica anónima (POST /e -> POST /colimago-logs del backend, colección
# colimago_logs). En Vercel solo se registra en Production; en local queda
# apagada salvo que ANALITICA_ACTIVO valga 1, y entonces escribe en el backend
# de COLIMA_BACKEND_URL (déjala en 0 si ese es el de producción).
# COLIMAGO_LOGS_KEY es la clave compartida con el backend (secreta: el mismo
# valor en Heroku y en Vercel, nunca en git). Sin ella no se manda nada.
# Ver "Analítica" en el README.
ANALITICA_ACTIVO=0
COLIMAGO_LOGS_KEY=

# Este panel no se conecta a Mongo para nada: todo pasa por el backend real
# de ColimaApp (NestJS) — login, eventos, producción, posts (locales y
# búsqueda libre), lugares y directorio. Incluye el prefijo /api que ese
# backend usa para todas sus rutas (ver src/main.ts ->
# app.setGlobalPrefix('api')).
# Producción: https://colimaapp.herokuapp.com/api
COLIMA_BACKEND_URL=http://localhost:3000/api

# Firma las cookies de sesión de este panel (login con Google). Genera un
# valor real, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=...

# Debe coincidir con src/common/constants/admin.constant.ts en
# backColimaApp. No es secreto; decide qué cuenta de Google puede entrar.
ADMIN_USER_ID=6705a6ce37e1cf2548b7f44c

# Guía web (ver README, sección "Guía web"). Todas opcionales.
# Google AdSense. El ID de editor ya está en el código (ca-pub-5479273904422379):
# con él la guía carga el script y publica /ads.txt. Solo hace falta definir
# ADSENSE_CLIENT para cambiarlo (vacío = apagar AdSense). Sin los dos números de
# unidad de abajo, cada espacio muestra una promo propia de Colima Go.
# ADSENSE_CLIENT=ca-pub-5479273904422379
ADSENSE_SLOT_BANNER=
ADSENSE_SLOT_FEED=
# Client id de Google para el login de usuarios de la guía (por defecto, el de
# la portada). SESSION_SECRET (arriba) también cifra su cookie de sesión.
GOOGLE_CLIENT_ID_WEB=
